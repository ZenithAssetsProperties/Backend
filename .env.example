# ==============================================================================
# Zenith Assets Properties — Production & Environment Configuration Template
# ==============================================================================

# ASP.NET Core Runtime
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# PostgreSQL 16 Primary Connection String
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=postgres;Port=5432;Database=zenith_assets_db;Username=zenith_admin;Password=YourSecureProductionPasswordGoesHere;SSL Mode=Prefer;Trust Server Certificate=true

# Redis 7 Cluster / Standalone Connection String
CONNECTIONSTRINGS__REDIS=redis:6379,password=YourSecureRedisPasswordGoesHere,abortConnect=false

# JSON Web Token (JWT) Security Configuration
JWT__SECRETKEY=Replace_With_A_Cryptographically_Secure_64_Byte_Key_For_Production_Signatures
JWT__ISSUER=ZenithAssets.Api
JWT__AUDIENCE=ZenithAssets.Clients
JWT__EXPIRYMINUTES=15

# Paystack Payment Gateway API Keys (Live / Test)
PAYSTACK__SECRETKEY=sk_live_your_actual_paystack_secret_key_here
PAYSTACK__PUBLICKEY=pk_live_your_actual_paystack_public_key_here
PAYSTACK__CALLBACKURL=https://app.zenithassets.ng/payment/callback

# Secure Object Storage (S3 / Cloudflare R2 / Google Cloud Storage)
STORAGE__BASEURL=https://storage.zenithassets.ng
STORAGE__SIGNINGSECRET=Replace_With_A_Secret_For_PreSigned_URL_HMAC_Tokens

# Communication Gateways (WhatsApp Cloud API & SMS)
NOTIFICATIONS__WHATSAPP_TOKEN=your_meta_whatsapp_business_token_here
NOTIFICATIONS__TERMII_API_KEY=your_termii_nigerian_sms_api_key_here
